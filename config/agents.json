{
  "harness": {
    "max_review_cycles": 8,
    "stall_limit": 2,
    "diff_dir": ".harness/review",
    "ledger": ".harness/ledger.md"
  },
  "tools": {
    "devin": {
      "readonly": {
        "model": "sonnet",
        "allowed-tools": ["read", "grep", "glob"],
        "permissions": { "deny": ["write", "edit", "notebook_edit", "exec"] }
      },
      "verifier": {
        "model": "sonnet",
        "allowed-tools": ["read", "grep", "glob", "exec"],
        "permissions": { "deny": ["write", "edit", "notebook_edit"] }
      },
      "implementer": {
        "model": "sonnet",
        "allowed-tools": ["read", "grep", "glob", "exec", "edit", "write"]
      }
    },
    "antigravity": {
      "readonly": {
        "subagent": true,
        "mainAgent": false,
        "model": "inherit",
        "commandExecutionPolicy": "off",
        "tools": ["view_file", "grep_search", "find_by_name", "list_dir"]
      },
      "verifier": {
        "subagent": true,
        "mainAgent": false,
        "model": "inherit",
        "commandExecutionPolicy": "sandbox"
      },
      "implementer": {
        "subagent": true,
        "mainAgent": false,
        "model": "inherit",
        "commandExecutionPolicy": "sandbox"
      }
    },
    "claude": {
      "readonly": {
        "model": "sonnet",
        "effort": "high",
        "tools": ["Read", "Glob", "Grep"]
      },
      "verifier": {
        "model": "sonnet",
        "tools": ["Read", "Glob", "Grep", "Bash"],
        "disallowedTools": ["Edit", "Write", "NotebookEdit"]
      },
      "implementer": { "model": "sonnet" }
    },
    "cursor": {
      "readonly": { "model": "inherit", "readonly": true, "is_background": false },
      "verifier": { "model": "inherit", "readonly": false, "is_background": false },
      "implementer": { "model": "inherit", "readonly": false, "is_background": false }
    },
    "codex": {
      "readonly": { "sandbox_mode": "read-only", "model_reasoning_effort": "high" },
      "verifier": { "sandbox_mode": "workspace-write" },
      "implementer": { "sandbox_mode": "workspace-write" }
    }
  },
  "tool_meta": {
    "devin":       { "out_dir": ".devin/agents",  "ext": ".md",   "layout": "flat" },
    "antigravity": { "out_dir": ".agent/agents",  "ext": ".md",   "layout": "dir", "file_name": "agent" },
    "claude":      { "out_dir": ".claude/agents", "ext": ".md",   "layout": "flat" },
    "cursor":      { "out_dir": ".cursor/agents", "ext": ".md",   "layout": "flat" },
    "codex":       { "out_dir": ".codex/agents",  "ext": ".toml", "layout": "flat" }
  }
}
