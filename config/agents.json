{
  "harness": {
    "max_review_cycles": 8,
    "stall_limit": 2,
    "diff_dir": ".roster/review",
    "ledger": ".roster/ledger.md"
  },
  "tools": {
    "devin": {
      "readonly": {
        "model": "glm-5-2",
        "allowed-tools": ["read", "grep", "glob"]
      },
      "verifier": {
        "model": "glm-5-2",
        "allowed-tools": ["read", "grep", "glob", "exec"]
      },
      "implementer": {
        "model": "glm-5-2",
        "allowed-tools": ["read", "grep", "glob", "exec", "edit", "write"]
      },
      "role_overrides": {
        "code-reviewer": { "model": "swe-1-7" }
      }
    },
    "antigravity": {
      "readonly": {
        "subagent": true,
        "mainAgent": false,
        "model": "inherit",
        "commandExecutionPolicy": "off",
        "tools": ["view_file", "grep_search", "find_by_name", "list_dir"]
      },
      "verifier": {
        "subagent": true,
        "mainAgent": false,
        "model": "inherit",
        "commandExecutionPolicy": "sandbox",
        "tools": ["view_file", "grep_search", "find_by_name", "list_dir", "run_command"]
      },
      "implementer": {
        "subagent": true,
        "mainAgent": false,
        "model": "inherit",
        "commandExecutionPolicy": "sandbox"
      }
    },
    "claude": {
      "readonly": {
        "model": "sonnet",
        "effort": "high",
        "tools": ["Read", "Glob", "Grep"]
      },
      "verifier": {
        "model": "sonnet",
        "tools": ["Read", "Glob", "Grep", "Bash"],
        "disallowedTools": ["Edit", "Write", "NotebookEdit"]
      },
      "implementer": { "model": "sonnet" }
    },
    "cursor": {
      "readonly": { "model": "inherit", "readonly": true, "is_background": false },
      "verifier": { "model": "inherit", "readonly": false, "is_background": false },
      "implementer": { "model": "inherit", "readonly": false, "is_background": false }
    },
    "codex": {
      "readonly": { "sandbox_mode": "read-only", "model_reasoning_effort": "high" },
      "verifier": { "sandbox_mode": "workspace-write" },
      "implementer": { "sandbox_mode": "workspace-write" }
    }
  },
  "tool_meta": {
    "devin":       { "out_dir": ".devin/agents",  "ext": ".md",   "layout": "flat" },
    "antigravity": { "out_dir": ".agent/agents",  "ext": ".md",   "layout": "dir", "file_name": "agent" },
    "claude":      { "out_dir": ".claude/agents", "ext": ".md",   "layout": "flat" },
    "cursor":      { "out_dir": ".cursor/agents", "ext": ".md",   "layout": "flat" },
    "codex":       { "out_dir": ".codex/agents",  "ext": ".toml", "layout": "flat" }
  },
  "skill_meta": {
    "claude":      { "out_dir": ".claude/skills" },
    "devin":       { "out_dir": ".devin/skills" },
    "antigravity": { "out_dir": ".agent/skills" },
    "codex":       { "out_dir": ".codex/skills" }
  },
  "dispatch_lines": {
    "claude":      "Dispatch each role with the `Agent` tool (`subagent_type: <role>`). Independent roles go in one message; the calls return synchronously.",
    "devin":       "Dispatch each role with `run_subagent` using the `subagent_general` profile, instructing it to read `agents/roles/<role>/role.md`. **Run writers in the foreground** — a background subagent auto-denies tools you have not approved this session.",
    "antigravity": "Dispatch each role with `invoke_subagent` (`TypeName: <role>`, `Workspace: inherit`). The call is **asynchronous** — poll every worker until it is `Idle` before reading anything it produced.",
    "codex":       "Ask for each agent by name: \"spawn the `<role>` agent with this spec\". Codex waits for all spawned agents and returns a consolidated result."
  }
}
